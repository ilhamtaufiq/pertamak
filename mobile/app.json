{
  "expo": {
    "name": "Pertamak Mobile Hub",
    "slug": "mobile",
    "version": "1.0.0",
    "description": "Aplikasi pelaporan kegiatan lapangan untuk Kabupaten Cianjur",
    "keywords": [
      "pertamak",
      "kegiatan",
      "cianjur",
      "laporan lapangan",
      "mobile"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/70dcd093-a357-46f7-9c37-e4f8b7ab25b2"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pertamak.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.pertamak.mobile",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "meta": {
        "title": "Pertamak - Aplikasi Kegiatan Lapangan",
        "description": "Aplikasi pelaporan dan monitoring kegiatan lapangan untuk Kabupaten Cianjur",
        "keywords": "pertamak, kegiatan, cianjur, laporan lapangan"
      },
      "manifest": {
        "display": "standalone",
        "themeColor": "#0EA5E9",
        "backgroundColor": "#020617",
        "lang": "id-ID",
        "categories": [
          "business",
          "productivity"
        ]
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Izinkan Pertamak mengakses lokasi Anda untuk pelacakan kegiatan."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "70dcd093-a357-46f7-9c37-e4f8b7ab25b2"
      }
    }
  }
}